{
  "name": "setsail-electron",
  "version": "5.140.0",
  "private": true,
  "main": "main.js",
  "description": "SetSail Windows desktop (Electron) — Wi-Fi AIS LAN bridge",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64",
    "dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "ai.setsail.app",
    "productName": "SetSail",
    "directories": {
      "output": "../../downloads/windows"
    },
    "files": [
      "main.js",
      "preload.js",
      "../../www/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": ["nsis"],
      "artifactName": "SetSail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
