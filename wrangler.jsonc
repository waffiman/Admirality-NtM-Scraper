{
  "name": "admirality-ntm-scraper",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./public",
  // Optional local/dev secrets: copy to .dev.vars (not committed)
  // SETSAIL_ANALYTICS_GITHUB_TOKEN=
  // SETSAIL_GOOGLE_CLIENT_ID=
  // TURNSTILE_SITE_KEY=
  // TURNSTILE_SECRET_KEY=
  // GEMINI_API_KEY=
  // COHERE_API_KEY=
  // SETSAIL_API_SIGNING_SECRET=
  // SETSAIL_PUBLIC_BASE=https://setsail-nav.com
  "vars": {
    "SETSAIL_PUBLIC_BASE": "https://setsail-nav.com"
  }
}
